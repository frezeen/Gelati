{
  "enabled": true,
  "name": "Ingredient Calculator",
  "description": "Automatically searches technical parameters online for new ingredients and adds them to lookup tables when text is selected that contains ingredient names not found in the rules file.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Text has been selected that may contain a new ingredient name. Check if this ingredient exists in the 'regole gelato agosto 2025 rev 2.txt' file. If not found, search online for technical parameters: 1) Nutritional composition (sugars, fats, proteins, water), 2) Specific density (g/ml), 3) POD and PAC coefficients based on sugar content, 4) Recommended dosage for Ninja Creami Deluxe, 5) Operational limits, 6) Required POD/PAC target adjustments. Format results to add to the lookup tables in the rules file. Use only professional gelato sources."
  }
}